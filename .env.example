[TEMPLATE]
# ---------------------------------------------------------------
# دفتر من — نمونهٔ متغیرهای محیطی
# این فایل را به .env.local کپی کنید و مقادیر را پر کنید.
# ---------------------------------------------------------------

# آدرس استقرار Convex بک‌اند
# با اجرای `bunx convex dev` ساخته و نمایش داده می‌شود
VITE_CONVEX_URL=https://<YOUR-CONVEX>.convex.cloud

# نشانی سایت برای احراز هویت (در توسعه: http://localhost:5173)
CONVEX_SITE_URL=http://localhost:5173

# نام استقرار Convex (فقط برای `bunx convex dev` محلی)
CONVEX_DEPLOYMENT=

# ---------------------------------------------------------------
# کلیدهای امضای توکن احراز هویت (اجباری برای ورود!)
# ساخت: bunx @convex-dev/auth  (یا هر کلید RS256 معتبر)
# این مقادیر باید در متغیرهای محیطیِ استقرار Convex نیز باشند:
#   bunx convex env set JWT_PRIVATE_KEY "..."
#   bunx convex env set JWKS "..."
#   bunx convex env set SITE_URL "http://localhost:5173"
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# پیکربندی ارسال کد ورود با ایمیل (SMTP مستقیم — بدون سرویس واسط)
# این مقادیر را در داشبورد Convex → Settings → Environment Variables
# نیز ثبت کنید تا سمت بک‌اند در دسترس باشد:
#   bunx convex env set SMTP_HOST "..."
#   bunx convex env set SMTP_USER "..."
#   bunx convex env set SMTP_PASSWORD "..."
# بدون SMTP، در استقرار محلی کد ورود در لاگ بک‌اند چاپ می‌شود.
# ---------------------------------------------------------------
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=
OTP_FROM="دفتر من" <no-reply@example.com>

# نام برنامه در متن نامهٔ کد ورود (اختیاری)
OTP_APP_NAME=دفتر من
